{
  "title": "SO1 Proyecto 2 - Telemetria",
  "uid": "so1-pr2",
  "schemaVersion": 41,
  "version": 5,
  "refresh": "20s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "RAM Total (KB)",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "query": "GET system:ram:total" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RAM Usada (KB)",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "query": "GET system:ram:used" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000000 },
              { "color": "red", "value": 14000000 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memoria Libre (KB)",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "query": "GET system:ram:free" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 500000 },
              { "color": "green", "value": 2000000 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Contenedores Eliminados",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "query": "GET containers:killed:count" }],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" } ] } }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Eventos eBPF",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "query": "GET ebpf:events:count" }]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Top 5 por RAM (KB) - historial uso",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "command": "hgetall", "keyName": "containers:top:ram" }],
      "options": { "orientation": "horizontal", "displayMode": "basic" },
      "fieldConfig": { "defaults": { "max": 1000000, "min": 0 } }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top 5 por CPU (x100 %) - contenedores eliminados: GET containers:killed:count",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "command": "hgetall", "keyName": "containers:top:cpu" }],
      "options": { "orientation": "horizontal", "displayMode": "basic" },
      "fieldConfig": { "defaults": { "max": 10000, "min": 0 } }
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Top 5 Contenedores por Consumo de RAM (KB)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "command": "hgetall", "keyName": "containers:top:ram" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "pie",
        "displayLabels": ["name", "value"]
      }
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Top 5 Contenedores por Consumo de CPU (x100 %)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "datasource": { "uid": "P2392AD6B339F5133" },
      "targets": [{ "refId": "A", "command": "hgetall", "keyName": "containers:top:cpu" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "pie",
        "displayLabels": ["name", "value"]
      }
    }
  ]
}
